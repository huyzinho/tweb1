<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GA6789 - Trung Tâm Hỗ Trợ</title>
<link rel="icon" href="/img.alltocon.com/img/static/pwa/vi6prod.png">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: Roboto, sans-serif;
  background: url('/img.alltocon.com/img/support/bg.webp') top center no-repeat;
  background-attachment: fixed;
  background-size: cover;
  min-height: 100vh;
  color: #fff;
}
.support-wrapper {
  max-width: 530px;
  margin: 0 auto;
  padding: 30px 10px;
}
.support-card {
  background-color: rgba(25, 37, 63, 0.837);
  border: 1px solid rgb(25, 37, 63);
  border-radius: 20px;
  padding: 10px 10px 30px 10px;
  position: relative;
}
.page-title {
  text-align: center;
  padding: 15px 0 5px;
}
.page-title h1 {
  font-size: 1.4rem;
  font-weight: 700;
  color: #fff;
  text-transform: uppercase;
  margin: 0;
}
.logo-wrap {
  text-align: center;
  position: relative;
  z-index: 1;
}
.logo-wrap img {
  width: 36%;
  height: auto;
}
.head-bg-wrap {
  text-align: center;
}
.head-bg-wrap img {
  width: 100%;
  height: auto;
  display: block;
}
.desc-text {
  font-size: 0.9rem;
  line-height: 1.4;
  text-align: center;
  color: #fff;
  padding: 0 20px;
  margin-top: 10px;
}
.desc-text strong { font-weight: bold; }

/* Button rows */
.btn-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 15px 0;
  max-width: 420px;
  margin: 0 auto;
}
.icon-left {
  flex: 0 0 49px;
  width: 49px;
  height: 49px;
  border-radius: 10px;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}
.icon-left img {
  width: 80%;
  height: auto;
}
.icon-left.green { background: linear-gradient(0deg, #0fd125 -6.88%, #127e44 91.31%); }
.icon-left.orange { background: linear-gradient(0deg, #d1810f -6.88%, #7e4712 91.31%); }
.icon-left.blue { background: linear-gradient(0deg, #113486 -6.88%, #1043be 91.31%); }

.btn-right {
  flex: 1;
  display: block;
  height: 49px;
  border-radius: 32px;
  font-weight: 900;
  font-size: 16px;
  line-height: 49px;
  text-align: center;
  color: #fff;
  text-decoration: none;
  cursor: pointer;
  border: none;
}
.btn-right.green {
  background: linear-gradient(0deg, #0fd125 -6.88%, #127e44 91.31%);
  font-size: 22px;
  line-height: 54px;
  height: 54px;
}
.btn-right.orange { background: linear-gradient(0deg, #d1810f -6.88%, #7e4712 91.31%); }
.btn-right.blue { background: linear-gradient(0deg, #0f48d1 -6.88%, #12327e 91.31%); }

@keyframes zoomPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}
.btn-zoom-pulse { animation: zoomPulse 1.2s ease-in-out infinite; }
.btn-zoom-pulse:hover { animation-play-state: paused; transform: scale(1.12) !important; }

/* Social icons row */
.social-row {
  display: flex;
  justify-content: center;
  gap: 14px;
  padding: 15px 20px 0;
}
.social-icon {
  width: 60px;
  height: 60px;
  display: block;
}
.social-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.ga6789-brand, .ga6789-highlight {
  transition: color 0.2s ease-in-out !important;
  display: inline !important;
}
.ga6789-brand:hover, .ga6789-highlight:hover,
*:hover > .ga6789-brand, *:hover > .ga6789-highlight,
a:hover .ga6789-brand, a:hover .ga6789-highlight {
  color: var(--platform-color-highlight, #f9752d) !important;
}
</style>
</head>
<body>

<div class="support-wrapper">
  <div class="support-card">

    <!-- Title -->
    <div class="page-title">
      <h1>TRUNG TÂM HỖ TRỢ</h1>
    </div>

    <!-- Logo -->
    <div class="logo-wrap">
      <a href="/"><img src="/img.alltocon.com/img/support/logo-ga6789.webp" alt="GA6789"></a>
    </div>

    <!-- Header background image -->
    <div class="head-bg-wrap">
      <img src="/img.alltocon.com/img/support/bg-head.webp" alt="">
    </div>

    <!-- Description -->
    <div class="desc-text">
      <strong>LINK TỔNG HỢP CÁC KÊNH CHĂM SÓC KHÁCH HÀNG VÀ TRUYỀN THÔNG CHÍNH THỨC CỦA <span class="ga6789-brand">GA6789</span>.<br>
      VUI LÒNG LƯU LẠI 1 PHƯƠNG THỨC ĐỂ CÓ THỂ LẤY LINK DỰ PHÒNG MỚI NHẤT NẾU ĐƯỜNG LINK <span class="ga6789-brand">GA6789</span>.COM BỊ CHẶN</strong>
    </div>

    <div class="spacer"></div>

    <!-- CSKH 24/7 -->
    <div class="btn-row">
      <div class="icon-left green">
        <img src="/img.alltocon.com/img/support/24h-1.png" alt="24h">
      </div>
      <a href="#" class="btn-right green btn-zoom-pulse">
        CSKH HỖ TRỢ 24/7
      </a>
    </div>

    <!-- CSKH Telegram -->
    <div class="btn-row">
      <div class="icon-left orange">
        <img src="/img.alltocon.com/img/support/support_1.png" alt="Support">
      </div>
      <a href="#" class="btn-right orange">CSKH HỖ TRỢ TRÊN TELEGRAM</a>
    </div>

    <!-- Khiếu nại Telegram -->
    <div class="btn-row">
      <div class="icon-left blue">
        <img src="/img.alltocon.com/img/support/khieunai.png" alt="Khiếu nại">
      </div>
      <a href="#" class="btn-right blue">TELEGRAM HỖ TRỢ KHIẾU NẠI</a>
    </div>

    <div class="spacer"></div>

    <!-- Social icons row -->
    <div class="social-row">
      <a href="#" class="social-icon">
        <img src="/img.alltocon.com/img/support/telegram-logo-2.webp" alt="Telegram">
      </a>
      <a href="#" class="social-icon">
        <img src="/img.alltocon.com/img/support/fb.png" alt="Facebook">
      </a>
      <a href="#" class="social-icon">
        <img src="/img.alltocon.com/img/support/android-copy.svg" alt="Android">
      </a>
      <a href="#" class="social-icon">
        <img src="/img.alltocon.com/img/support/ios-copy.svg" alt="iOS">
      </a>
    </div>

  </div>
</div>

</body>
</html>
